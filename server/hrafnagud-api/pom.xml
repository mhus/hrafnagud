<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.hrafnagud</groupId>
        <artifactId>hrafnagud</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hrafnagud-api</artifactId>
    <name>hrafnagud-api</name>
    <description>API contract — DTOs and enums crossing the REST boundary. No Spring, no MongoDB, no business logic, so the module stays usable as the input for generated clients.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            Jackson annotations only (not databind): Spring Boot 4 registers a
            Jackson 3 ObjectMapper, which still understands the Jackson 2
            annotation package. Keeping databind out of this module is what
            makes it consumable without a serialisation runtime.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
