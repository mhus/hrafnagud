<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.hrafnagud</groupId>
        <artifactId>hrafnagud</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hrafnagud-translate</artifactId>
    <name>hrafnagud-translate</name>
    <description>Works Munin's translation backlog. Its own module so Munin keeps no dependency on Vancetope: the archive must remain collectable and queryable without a brain, and translation is the one part that reaches outside.</description>
    <packaging>jar</packaging>

    <properties>
        <vance.ode.version>0.1.0-SNAPSHOT</vance.ode.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.mhus.hrafnagud</groupId>
            <artifactId>hrafnagud-munin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            The Vancetope binding. Ode is inert until vance.ode.base-url
            is configured, so an installation that translates by other
            means — or not at all — carries this without effect.
        -->
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-ursa</artifactId>
            <version>${vance.ode.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
