<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.hrafnagud</groupId>
        <artifactId>hrafnagud</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hrafnagud-server</artifactId>
    <name>hrafnagud-server</name>
    <description>Boot module — assembles the deployable Spring Boot application from the feature modules. Holds the runtime configuration and nothing else, so a future Hugin (query/analysis) module can be added beside Munin without either owning the entrypoint.</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>de.mhus.hrafnagud</groupId>
            <artifactId>hrafnagud-munin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Translation is assembled in, not built in: Munin has no
            dependency on Vancetope, and dropping this module leaves a
            collector that still works, just monolingual.
        -->
        <dependency>
            <groupId>de.mhus.hrafnagud</groupId>
            <artifactId>hrafnagud-translate</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hrafnagud</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
