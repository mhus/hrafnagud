# hrafnagud — __PUBLIC_HOST__
#
# TEMPLATE. install-caddy.sh substitutes __PUBLIC_HOST__ and __NODE_PORT__
# before uploading, and wraps the result in marker comments so re-installing
# replaces this block in place and leaves the rest of the host's Caddyfile
# alone.
#
# Only the two Ode paths are published — the feed contract and the search
# contract. The rest of the API — the whole of /api/v1, which can add sources,
# trigger refreshes, read everything collected and delete it — stays inside the
# cluster, reachable via `kubectl port-forward` or the SSH tunnel. It is guarded
# by HRAFNAGUD_API_TOKEN, but that is one shared token with no accounts, no rate
# limiting and no audit trail: enough to keep the port honest, not enough to put
# a write API on the open internet. The console at / is published just as
# little, for the same reason.
#
# Both are safe to expose only once their key is set —
# HRAFNAGUD_CENTAURI_API_KEY and HRAFNAGUD_ZARNIWOOP_API_KEY: with an empty key
# the endpoint performs no check at all. The application logs which of the two
# states it is in at startup.
#
# Both paths, not just the feed: a search endpoint that Vancetope cannot reach is
# an endpoint that does not exist, and the module is enabled by the presence of
# its bean rather than by anything visible here.
__PUBLIC_HOST__ {
    handle /ode/feed* {
        reverse_proxy 127.0.0.1:__NODE_PORT__ {
            # Feed pages are small JSON responses; no streaming concerns, so
            # the default buffering is fine here.
            transport http {
                read_timeout 2m
                write_timeout 2m
            }
        }
    }

    handle /ode/search* {
        reverse_proxy 127.0.0.1:__NODE_PORT__ {
            # A body served through /ode/search/content can be a full article,
            # so the timeouts match the feed's rather than the default.
            transport http {
                read_timeout 2m
                write_timeout 2m
            }
        }
    }

    # Anything else on this host is not part of hrafnagud's public surface.
    handle {
        respond "not found" 404
    }

    header -Server
}
