# Copy to .env next to docker-compose.yaml and adjust. Every value has a
# working default, so an empty .env runs a monolingual collector against a
# local MongoDB.

# ── MongoDB ────────────────────────────────────────────────────────────
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
HRAFNAGUD_MONGO_DB=hrafnagud
# Host port for mongosh. Set empty to not publish MongoDB at all.
MONGO_PORT=27017

# ── hrafnagud ──────────────────────────────────────────────────────────
IMAGE_NAME=hrafnagud
IMAGE_TAG=latest
# Published on 127.0.0.1 only — the API is unauthenticated.
HRAFNAGUD_PORT=9800

# Give publishers someone to contact. An anonymous crawler is one that
# gets blocked.
HRAFNAGUD_USER_AGENT=

# Fetch full article text from publisher pages (off by default: reading a
# feed and crawling the site it points at are different activities).
HRAFNAGUD_CONTENT_ENABLED=false

# Restrict language detection to the languages actually in the registry,
# e.g. "de,en,fr". Empty = all of Lingua's languages, which costs the most
# memory and time.
HRAFNAGUD_LANGUAGES=

# Outbound proxy for every fetch (feeds, source lists, article pages,
# robots.txt). A host without a valid port fails at startup rather than
# silently going direct.
HRAFNAGUD_PROXY_HOST=
HRAFNAGUD_PROXY_PORT=0

# ── Translation (needs a Vancetope brain) ──────────────────────────────
# The language everything is normalised into. Setting it starts filling a
# backlog — leave it empty unless the brain binding below is complete, or
# the queue grows with nothing draining it.
HRAFNAGUD_PIVOT_LANGUAGE=
VANCE_BRAIN_URL=
VANCE_TENANT=
VANCE_PROJECT=_tenant
VANCE_TRANSLATE_TOKEN=

# ── Operator API and console ───────────────────────────────────────────
# Bearer token for /api/v1/**, typed into the console at http://localhost:9800/.
# Empty means no check — fine while the port is bound to loopback, wrong
# otherwise, because this API deletes as well as reads.
HRAFNAGUD_API_TOKEN=
# The console itself is never guarded; it asks for the token. Set false to not
# serve it at all.
HRAFNAGUD_CONSOLE_ENABLED=true

# ── Centauri (serving the archive back to Vancetope) ───────────────────
HRAFNAGUD_CENTAURI_ENABLED=false
# Expected as `Authorization: Bearer <key>`. Empty means no check at all.
HRAFNAGUD_CENTAURI_API_KEY=

# ── Zarniwoop (the same archive as a research provider) ────────────────
HRAFNAGUD_ZARNIWOOP_ENABLED=false
# Expected as `Authorization: Bearer <key>`. Empty means no check at all.
HRAFNAGUD_ZARNIWOOP_API_KEY=
