# Template for the deploy env file. Copy it to ONE of these locations —
# the scripts take the first they find:
#
#   deploy/secrets.env                              (git-ignored)
#   ../../confidential/hrafnagud/secrets.env        (vance-wb checkout)
#   ~/.hrafnagud/deploy.env
#
# or point $HRAFNAGUD_DEPLOY_ENV at it. chmod 600 either way.
#
# This file is sourced by bash, so a value containing spaces or any of
# " ' $ ` | & * ( ) ; needs single quotes around it — a Mongo password is the
# usual case. The scripts handle such values correctly once they parse:
# nothing is passed through sed, and Secret values are base64-encoded.
#
# Only what you actually use needs a value: `build-image.sh` needs none of
# this, `push-image.sh` needs the registry block, the k8s scripts need
# HRAFNAGUD_MONGO_URI, and only the remote (Mini) path needs SSH_*.

# ── Registry ───────────────────────────────────────────────────────────
# Where push-image.sh publishes to:
#   ${REGISTRY}/${NAMESPACE}/${IMAGE_NAME}:<tag>
REGISTRY=docker.io
NAMESPACE=mhus
IMAGE_NAME=hrafnagud

# Optional. Both empty ⇒ the existing `docker login` session is used, which
# is the normal case on a workstation. A Docker Hub access token with
# "Read & Write" scope beats an account password:
#   https://hub.docker.com/settings/security
REGISTRY_USER=
REGISTRY_TOKEN=

# ── Kubernetes ─────────────────────────────────────────────────────────
# Namespace the manifests go into. Changing it here also means changing
# `namespace:` in deploy/k8s/base/kustomization.yaml and the name in
# deploy/k8s/base/namespace.yaml — kustomize will not read this file.
K8S_NAMESPACE=hrafnagud

# REQUIRED for the k8s scripts. Goes into the Secret; the prod profile has
# no default, so an unset value fails the boot by name instead of silently
# talking to the wrong database.
HRAFNAGUD_MONGO_URI=mongodb://root:CHANGEME@10.42.40.23:27017/hrafnagud?authSource=admin

# Bearer token for the operator API (/api/v1/**) and therefore for the
# console at /. Empty means no check at all — and this API deletes as well as
# reads, so leave it empty only where nothing else can reach the port.
# Generate with: openssl rand -hex 32
HRAFNAGUD_API_TOKEN=

# Ursa event token for the brain-side `translation` kit. Only meaningful
# together with VANCE_BRAIN_URL / VANCE_TENANT in the ConfigMap.
VANCE_TRANSLATE_TOKEN=

# Bearer key for the Centauri feed endpoint. Empty means the endpoint
# performs no check at all — set it before exposing the route publicly.
# Generate with: openssl rand -hex 32
HRAFNAGUD_CENTAURI_API_KEY=

# Bearer key for the Zarniwoop search endpoint. Same rule, separate key: the
# two endpoints are switched on independently, so one key for both would tie
# them together again — and a leaked key should cost one surface, not two.
HRAFNAGUD_ZARNIWOOP_API_KEY=

# ── Remote cluster (Mini / k3s over SSH) ───────────────────────────────
# Only needed for `apply.sh --remote` and everything under deploy/mini/.
# A cluster you reach through a normal kubeconfig needs none of it.
SSH_HOST=10.42.40.23
SSH_USER=root
SSH_KEY=

# NodePort the mini overlay publishes; used by the Caddy route and by
# `deploy/mini/deploy.sh forward`. Must match patch-service.yaml.
HRAFNAGUD_NODE_PORT=30980

# ── Public route (optional) ────────────────────────────────────────────
# Hostname Caddy should serve. Empty ⇒ no public route is installed at all,
# and the API stays reachable only inside the cluster. Only the
# API-key-protected /ode/feed path is published, never /api/v1.
HRAFNAGUD_PUBLIC_HOST=

# Path of the Caddyfile on the cluster host.
CADDYFILE_PATH=/mnt/data/caddy/Caddyfile
