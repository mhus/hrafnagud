<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>de.mhus.hrafnagud</groupId>
    <artifactId>hrafnagud</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>hrafnagud</name>
    <!--
        One artifact, not six. The split into api/munin/translate/centauri/
        zarniwoop/server made the layering compiler-enforced, which is worth
        paying for in software that loads third-party code — but hrafnagud has
        no add-on system and nobody consumes a part of it. What it bought was a
        boundary; what it cost was six poms, a reactor and cross-module test
        fixtures for a service one person builds in one go. Packages carry the
        same names and the same meaning; see specs/architecture.md §2 for the
        boundary that survives as a rule rather than as a dependency.
    -->
    <description>News aggregation service — collects, deduplicates and stores news from worldwide sources, and serves the archive to Vancetope as a feed and a research provider</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>25</java.version>
        <spring.boot.version>4.1.0</spring.boot.version>
        <lombok.version>1.18.46</lombok.version>
        <jspecify.version>1.0.1</jspecify.version>
        <vance.ode.version>0.2.0-SNAPSHOT</vance.ode.version>
        <!--
            langchain4j: the direct path to a model, for the translation
            provider that does not go through a brain. Same version Vancetope
            is on, deliberately — the two services translate the same articles
            and comparing two runs is easier when the client below them is not
            a second variable.

            The plain module rather than its Spring Boot starter: one model,
            one prompt, no agent, no tools. The starter would bring an
            autoconfiguration tree for none of that, and a version opinion
            about Spring Boot that this service does not need.
        -->
        <langchain4j.version>1.18.1</langchain4j.version>
        <!-- Rome: RSS 0.9x/1.0/2.0 + Atom 0.3/1.0 parsing. The feed zoo in the
             wild is broken in every way imaginable; Rome's XmlReader does
             encoding sniffing (XML decl vs. HTTP charset vs. BOM) which a
             plain JAXB/Jackson-XML route does not. -->
        <rome.version>2.1.0</rome.version>
        <!-- jsoup: HTML → text extraction for the full-article fetch, plus the
             XML parser used for OPML source lists. Tolerant of broken markup. -->
        <jsoup.version>1.23.1</jsoup.version>
        <!-- Lingua: statistical language detection over 75 languages, no
             transitive deps beyond kotlin-stdlib. Built lazily and in
             low-accuracy mode by default — see LinguaLanguageDetector for the
             memory trade-off. -->
        <lingua.version>1.2.2</lingua.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rometools</groupId>
                <artifactId>rome</artifactId>
                <version>${rome.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.pemistahl</groupId>
                <artifactId>lingua</artifactId>
                <version>${lingua.version}</version>
            </dependency>
            <!--
                No BOM import for one artifact: the module pins its own
                langchain4j-core and http-client at the same version, so a BOM
                would only add a second place for that version to live.
            -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-google-ai-gemini</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Declared although spring-boot-starter-web brings Jackson: the DTOs
            in de.mhus.hrafnagud.api annotate against it directly, and a direct
            import on a transitive dependency is how a build breaks on someone
            else's refactoring.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.pemistahl</groupId>
            <artifactId>lingua</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-google-ai-gemini</artifactId>
        </dependency>

        <!--
            The three Vancetope bindings — one that calls a brain, two that
            answer one. All three are inert unless configured: ode-ursa until
            vance.ode.base-url is set, the serving pair until munin.centauri /
            munin.zarniwoop are enabled. That is now a runtime property rather
            than a build-time one, which is the trade this merge made.
        -->
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-ursa</artifactId>
            <version>${vance.ode.version}</version>
        </dependency>
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-centauri</artifactId>
            <version>${vance.ode.version}</version>
        </dependency>
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-zarniwoop</artifactId>
            <version>${vance.ode.version}</version>
        </dependency>
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-jaglan</artifactId>
            <version>${vance.ode.version}</version>
        </dependency>
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-kit</artifactId>
            <version>${vance.ode.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hrafnagud</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                `kits/` into the jar, so the kits this service serves travel
                inside the artifact that depends on them. That is the whole
                point of them living here: a recipe and the code firing its
                event ship as one thing, and a version skew between the two
                becomes impossible rather than unlikely.

                Copied rather than moved under src/main/resources, because
                the directory is also a Vancetope kit source in its own right
                — `kits/<name>/kit.yaml` is the convention that lets the
                repository be cloned and used directly.

                The two files beside the kit directories are excluded: they
                describe the directory for a human and for a git-based kit
                consumer, and nothing reads them at runtime.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-kits</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/kits</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/kits</directory>
                                    <excludes>
                                        <exclude>README.md</exclude>
                                        <exclude>catalog.yaml</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Publishes one build property per resolved dependency, named
                `groupId:artifactId:type` and holding the jar's path in the
                local repository. Sole consumer is the Mockito `-javaagent` in
                the Surefire argLine below.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-jar-properties</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Mockito's inline mock-maker rewrites bytecode of loaded
                        classes, which needs a JVM instrumentation agent. Left
                        alone it self-attaches, which JEP 451 deprecated for
                        removal. Passing the agent at JVM start is the supported
                        route. The path expands from the `dependency:properties`
                        execution above, so the version stays owned by
                        spring-boot-starter-test.
                    -->
                    <argLine>
                        -javaagent:${org.mockito:mockito-core:jar}
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
